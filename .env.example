# SaidSigned environment template.
# `make env` writes a local .env with random values for the <generated> fields.
# Add the provider keys to .env yourself. Never commit .env.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=local
# Must stay false until HC-7 (legal) and HC-8 (release) are approved.
REAL_USERS=false
# false only for local http; true behind https.
COOKIE_SECURE=false
JWT_SECRET=<generated>

# ---------------------------------------------------------------------------
# Database (Postgres container in infra/docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=<generated>
DATABASE_URL=postgresql+asyncpg://saidsigned:<generated>@localhost:5432/saidsigned

# ---------------------------------------------------------------------------
# File storage (MinIO container, S3-compatible)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<generated>
S3_SECRET_KEY=<generated>
MINIO_KMS_SECRET_KEY=saidsigned-dev-key:<base64-32-bytes>

# ---------------------------------------------------------------------------
# Speech-to-text: ElevenLabs (task T1.2)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key

# ---------------------------------------------------------------------------
# LLM: Amazon Bedrock Mantle (claim extraction, task T1.6)
# ---------------------------------------------------------------------------
LLM_PROVIDER=bedrock_mantle
LLM_TIMEOUT_MS=120000
# Gemma 4 is served only under the /openai/v1 path; /v1 returns an error for this model.
MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
MANTLE_API_KEY=replace_with_mantle_api_key
MANTLE_PROJECT=default
# Gemma 4 31B (In-Region only: us-east-1, us-east-2, us-west-2, eu-central-1).
MANTLE_MODEL=google.gemma-4-31b
MANTLE_MAX_TOKENS=4096
